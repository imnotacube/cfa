<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>{% block title %}Default title{% endblock title %}</title>
</head>
<body>
    <nav class="navbar navbar-expand-lg bg-dark border-bottom border-body" data-bs-theme="dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/cfa">CubeFel Account</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarColor01">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          <li class="nav-item">
            <a class="nav-link" aria-current="page" href="/cfa/my">Личный кабинет</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/cfa/login">Меню входа</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/cfa/info">Инфо</a>
          </li>
          <li class="nav-item">
            <a class="nav-link">Версия от 21.09.2024</a>
          </li>
        </ul>
        
      </div>
    </div>
  </nav>
    <h1>{% block header %}{% endblock header %}</h1>
    <div>{% block content%}{% endblock content %}</div>
   
</body>
</html>
